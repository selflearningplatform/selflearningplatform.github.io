---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

const { title, description = 'SLP, the Self Learning Platform: an agent-powered hub for self-learners.' } = Astro.props;
const path = Astro.url.pathname;
const current = href => (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title ? `独学 · ${title}` : '独学 · SLP Self Learning Platform'}</title>
<meta name="description" content={description}>
<link rel="icon" href="/app/assets/favicon.svg">
<link rel="preload" href="/app/vendor/jetbrains-mono/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/app/vendor/jetbrains-mono/JetBrainsMono-Bold.woff2" as="font" type="font/woff2" crossorigin>
<slot name="head" />
<ClientRouter />
<script is:inline>
  const legacy = location.hash.match(/^#(docs\/[\w-]+|docs|identity|home)$/);
  if (legacy) location.replace('/' + legacy[1].replace('home', ''));
</script>
</head>

<body>
<header class="nav">
  <div class="wrap">
    <a href="/" aria-label="home"><img src="/app/assets/mark.png" alt="独学" width="24" height="24"></a>
    <nav>
      <a href="/" aria-current={current('/')}>home</a>
      <a href="/docs/overview" aria-current={current('/docs')}>docs</a>
      <a href="/identity" aria-current={current('/identity')}>identity</a>
      <a href="https://github.com/GustavoPenaBeltrami/self-learning-platform">github ↗</a>
    </nav>
  </div>
</header>

<main class="wrap">
  <slot />
  <footer><span>独学 · SLP Self Learning Platform  · By <a target="_blank" href="https://www.linkedin.com/in/gustavo-pena-beltrami/">Gustavo</a> to anyone</span><span><a href="https://github.com/GustavoPenaBeltrami/self-learning-platform/blob/main/LICENSE">MIT</a> · ~ EOF</span></footer>
</main>

<aside class="pip" data-mode="bottom" hidden transition:persist>
  <div class="pip-bar">
    <span>demo</span>
    <span>
      <a href="https://youtu.be/q_26omGX7AI" target="_blank" rel="noopener" aria-label="open on YouTube"><svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5"/></svg></a>
      <button type="button" data-act="size"></button>
      <button type="button" data-act="close" aria-label="close"><svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7"/></svg></button>
    </span>
  </div>
  <video src="/app/assets/video.mp4" muted loop playsinline></video>
</aside>
<script is:inline>
  (() => {
    if (window.pipInit) return;
    window.pipInit = true;
    const pip = document.querySelector('.pip');
    const store = (k, v) => { try { return v === undefined ? sessionStorage.getItem(k) : sessionStorage.setItem(k, v); } catch {} };
    if (performance.getEntriesByType('navigation')[0]?.type === 'reload') try { sessionStorage.removeItem('pip-closed'); } catch {}
    if (store('pip-closed')) return;
    pip.dataset.mode = store('pip-mode') === 'center' ? 'center' : 'bottom';
    pip.hidden = false;
    const video = pip.querySelector('video');
    video.play().catch(() => {});
    const size = pip.querySelector('[data-act="size"]');
    const set = m => {
      pip.dataset.mode = m; store('pip-mode', m);
      const big = m === 'center';
      size.innerHTML = big ? '<svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M2 9.5h8"/></svg>' : '<svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M2.5 2.5h7v7h-7z"/></svg>';
      size.ariaLabel = big ? 'minimize to bottom right' : 'enlarge to center';
    };
    set(pip.dataset.mode);
    pip.addEventListener('click', e => {
      const act = e.target.closest('[data-act]')?.dataset.act;
      if (act === 'size') set(pip.dataset.mode === 'center' ? 'bottom' : 'center');
      if (act === 'close') { video.pause(); pip.hidden = true; store('pip-closed', '1'); }
    });
  })();
</script>
</body>
</html>
