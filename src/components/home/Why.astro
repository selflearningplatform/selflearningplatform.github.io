---
const sentences = [
  'Reading is not learning.',
  'You learn when you explain it again and again, with someone pointing out your mistakes.',
];
let index = 0;
const lines = sentences.map(s => s.split(' ').map(text => ({ text, i: index++ })));
const last = index - 1;
---
<section class="why">
  <div class="why-stage">
    <div class="why-kanji" aria-hidden="true"><b>独</b><b>学</b></div>
    <div class="label">01 / why</div>
    <h2 class="why-statement" style={`--n:${index}`} aria-label={sentences.join(' ')}>
      {lines.map(words => (
        <span class="why-line" aria-hidden="true">
          {words.map(w => <span class:list={['w', { mark: w.i === last }]} style={`--i:${w.i}`}>{w.text} </span>)}
        </span>
      ))}
    </h2>
    <p class="why-intro">SLP gives you that someone, and a place to do the work. The teacher never answers for you. It asks before it tells, waits for you to try, and writes down what you got wrong so it comes back.</p>
    <div class="why-meter" aria-hidden="true"><i></i></div>
  </div>
</section>

<style>
  @property --why-p { syntax: '<number>'; inherits: true; initial-value: 1; }
  @keyframes why-progress { from { --why-p: 0; } to { --why-p: 1; } }

  .why > * { animation: none; }
  .why-stage { position: relative; overflow: hidden; display: grid; align-content: center; gap: 40px; }
  .why-stage .label { position: relative; margin: 0; }
  .why-kanji { position: absolute; top: 50%; right: 0; translate: 0 -50%; display: grid; pointer-events: none; user-select: none; }
  .why-kanji b { font: 900 clamp(150px, 30vw, 440px)/1 var(--kanji); color: var(--graphite); }
  .why-kanji b:nth-child(1) { translate: 0 calc((.5 - var(--why-p)) * 90%); }
  .why-kanji b:nth-child(2) { translate: 0 calc((.5 - var(--why-p)) * 70%); }
  .why-statement { position: relative; max-width: 24ch; font: 700 clamp(26px, 4.4vw, 60px)/1.12 "JetBrains Mono", ui-monospace, monospace; letter-spacing: -.035em; color: var(--paper); --r: calc((var(--why-p) - .04) / .66 * var(--n)); }
  .why-line { display: block; }
  .why-line + .why-line { margin-top: .5em; }
  .w { --o: clamp(0, var(--r) - var(--i), 1); opacity: max(.16, var(--o)); }
  .w.mark { position: relative; }
  .w.mark::after { content: ""; position: absolute; left: 0; right: .7em; bottom: -.04em; height: .07em; background: var(--paper); transform: scaleX(var(--o)); transform-origin: left; }
  .why-intro { position: relative; max-width: 52ch; margin-left: auto; color: var(--chalk); text-wrap: pretty; --q: clamp(0, (var(--why-p) - .74) * 6, 1); opacity: var(--q); translate: 0 calc((1 - var(--q)) * 24px); }
  .why-meter { position: relative; height: 1px; background: var(--iron); }
  .why-meter i { display: block; height: 100%; background: var(--fog); transform: scaleX(var(--why-p)); transform-origin: left; }

  @media (prefers-reduced-motion: no-preference) {
    .why { height: 320vh; padding: 0; }
    .why-stage { position: sticky; top: 56px; height: calc(100vh - 56px); height: calc(100svh - 56px); padding: 40px 0; }
    @supports (animation-timeline: view()) {
      .why { animation-name: why-progress; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(block 56px 0px); animation-range: contain 0% contain 100%; }
    }
  }
</style>

<script>
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');
  let stop: (() => void) | undefined;
  const teardown = () => { stop?.(); stop = undefined; };

  document.addEventListener('astro:page-load', () => {
    teardown();
    const why = document.querySelector<HTMLElement>('.why');
    if (!why || !motion.matches || CSS.supports('animation-timeline: view()')) return;
    let frame = 0;
    const update = () => {
      frame = 0;
      const box = why.getBoundingClientRect();
      const span = box.height - innerHeight + 56;
      why.style.setProperty('--why-p', String(Math.min(1, Math.max(0, (56 - box.top) / span))));
    };
    const schedule = () => { frame ||= requestAnimationFrame(update); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    update();
    stop = () => {
      removeEventListener('scroll', schedule);
      removeEventListener('resize', schedule);
      cancelAnimationFrame(frame);
    };
  });
  document.addEventListener('astro:before-swap', teardown);
</script>
