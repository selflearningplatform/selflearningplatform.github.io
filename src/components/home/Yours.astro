---
const agents = [
  { name: 'Claude Code', setup: '.claude/skills → agent/skills' },
  { name: 'Codex', setup: '.agents/skills → agent/skills' },
  { name: 'Cursor', setup: 'reads AGENTS.md' },
  { name: 'Gemini CLI', setup: '.gemini/skills → agent/skills' },
  { name: 'opencode + Ollama', setup: 'reads AGENTS.md · model runs on your machine' },
  { name: 'any agent that reads files', setup: 'reads AGENTS.md' },
];
const chips = ['.md', '.json', '.jsonl', '.md'];
---
<section id="yours" data-net="on">
  <div class="label">07 / yours</div>
  <div class="chips" aria-hidden="true">{chips.map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</div>
  <div class="cols" data-reveal>
    <div class="prose side-a">
      <h2>Everything is a file on your disk.</h2>
      <p>No account, no database, no subscription. Notes are Markdown, exams and cards are JSON. Open them in any editor, put them in git, write any of it by hand.</p>
      <div class="net-bar">
        <button class="net" type="button" aria-pressed="false"><span class="dot"></span><span class="net-on">online</span><span class="net-off">offline</span></button>
        <span class="hint">hover a row or tap to cut the network</span>
      </div>
      <div class="rows">
        <div tabindex="0" data-offline style="--i:0"><span>app, notes, cards, exams</span><span class="ok">✓ offline</span></div>
        <div tabindex="0" data-offline style="--i:1"><span>teacher + local model</span><span class="ok">✓ offline</span></div>
        <div class="cloud" style="--i:2"><span>teacher + cloud model</span><span><span class="net-on muted">needs internet</span><span class="net-off">✕ no network</span></span></div>
      </div>
    </div>
    <div class="prose side-b">
      <h2>Any agent, any model.</h2>
      <p>The skills use the <code>SKILL.md</code> format and <code>AGENTS.md</code> explains the project to any agent. Use a cloud model, or a local one through Ollama. Free and open source: the only cost is the model your agent already uses.</p>
      <ul class="dash agents">
        {agents.map((a, i) => <li style={`--i:${i}`}>- <button type="button" data-setup={a.setup}>{a.name}</button></li>)}
      </ul>
      <p class="setup" aria-live="polite"><span class="muted">❯</span> <code class="setup-v">slp-setup exposes agent/skills in each agent's format</code></p>
    </div>
  </div>
</section>

<style>
  section { position: relative; overflow-x: clip; }
  .cols { animation: none; }
  .chips { position: absolute; top: 28px; right: 0; display: flex; gap: 12px; font-size: 11px; color: var(--steel); }
  .chips span { border: 1px solid var(--iron); padding: 2px 8px; }
  .net-bar { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; font-size: 12px; }
  .net { font: inherit; color: var(--paper); background: none; border: 1px solid var(--slate); padding: 2px 10px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
  .net:hover, .net:focus-visible { border-color: var(--fog); outline: none; }
  .dot { width: 7px; height: 7px; border: 1px solid var(--paper); background: var(--paper); border-radius: 0; }
  .hint { color: var(--steel); }
  .net-off { display: none; }
  #yours[data-net="off"] .net-on { display: none; }
  #yours[data-net="off"] .net-off { display: inline; }
  #yours[data-net="off"] .dot { background: none; }
  #yours[data-net="off"] .ok { color: var(--paper); font-weight: 700; }
  #yours[data-net="off"] .cloud { color: var(--steel); }
  #yours[data-net="off"] .cloud > span:first-child { text-decoration: line-through; }
  .rows > div { position: relative; outline: none; }
  .rows > div[data-offline] { cursor: default; }
  .rows > div::before { content: ""; position: absolute; left: -1px; top: 0; bottom: 0; width: 2px; background: var(--paper); transform: scaleY(0); }
  .rows > div[data-offline]:hover, .rows > div[data-offline]:focus-visible { background: var(--graphite); color: var(--paper); }
  .rows > div[data-offline]:hover::before, .rows > div[data-offline]:focus-visible::before { transform: scaleY(1); }
  .agents button { font: inherit; color: var(--chalk); background: none; border: 0; padding: 0; cursor: pointer; text-align: left; }
  .agents button:hover, .agents button:focus-visible, .agents button.on { color: var(--paper); text-decoration: underline; text-underline-offset: 3px; outline: none; }
  .setup { font-size: 12px; min-height: 3.4em; border-top: 1px solid var(--iron); padding-top: 12px; }
  .setup-v { color: var(--paper); overflow-wrap: anywhere; }
  @media (max-width: 900px) { .chips { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .rows > div, .rows > div::before, .ok, .cloud, .agents button, .dot { transition: color .2s ease, background-color .2s ease, transform .25s cubic-bezier(.2, .7, .2, 1); }
    .rows > div > span:first-child { display: inline-block; transition: transform .25s cubic-bezier(.2, .7, .2, 1); }
    .rows > div[data-offline]:hover > span:first-child, .rows > div[data-offline]:focus-visible > span:first-child { transform: translateX(4px); }
    .agents button { transition: color .2s ease, transform .25s cubic-bezier(.2, .7, .2, 1); }
    .agents button:hover, .agents button:focus-visible, .agents button.on { transform: translateX(4px); }
    .setup-v { display: inline-block; }
    .setup-v.swap { animation-name: yours-type; animation-duration: .35s; animation-timing-function: steps(12, end); animation-fill-mode: both; }
    @keyframes yours-type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
    @keyframes yours-left { from { opacity: 0; transform: translateX(-64px); } }
    @keyframes yours-right { from { opacity: 0; transform: translateX(64px); } }
    @keyframes yours-rise { from { opacity: 0; transform: translateY(14px); } }
    @keyframes yours-float { from { transform: translateY(calc(24px + var(--i) * 10px)); } to { transform: translateY(calc(-24px - var(--i) * 10px)); } }
    @keyframes yours-line { from { transform: scaleX(0); } }
    .rows > div:not(:last-child)::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--slate); transform-origin: left; }
    .setup { position: relative; }
    @supports (animation-timeline: view()) {
      .side-a, .side-b { animation-timing-function: cubic-bezier(.2, .7, .2, 1); animation-fill-mode: both; animation-duration: auto; animation-timeline: view(); animation-range: entry 0% entry 80%; }
      .side-a { animation-name: yours-left; }
      .side-b { animation-name: yours-right; }
      .rows > div, .agents li { animation-name: yours-rise; animation-timing-function: linear; animation-fill-mode: both; animation-duration: auto; animation-timeline: view(); animation-range: entry calc(10% + var(--i) * 10%) entry calc(60% + var(--i) * 10%); }
      .rows > div:not(:last-child)::after { animation-name: yours-line; animation-timing-function: ease-out; animation-fill-mode: both; animation-duration: auto; animation-timeline: view(); animation-range: entry 40% cover 40%; }
      .chips span { display: inline-block; animation-name: yours-float; animation-timing-function: linear; animation-fill-mode: both; animation-duration: auto; animation-timeline: view(); animation-range: cover 0% cover 100%; }
    }
    :global(.reveal-io) #yours .prose { transition: opacity .7s ease-out, transform .7s cubic-bezier(.2, .7, .2, 1); }
    :global(.reveal-io) #yours .side-b { transition-delay: .15s; }
    :global(.reveal-io) #yours .cols:not(.in) .side-a { opacity: 0; transform: translateX(-48px); }
    :global(.reveal-io) #yours .cols:not(.in) .side-b { opacity: 0; transform: translateX(48px); }
  }
</style>

<script>
  let yoursAbort: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('yours');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    yoursAbort?.abort();
    yoursAbort = new AbortController();
    const { signal } = yoursAbort;
    const toggle = root.querySelector<HTMLButtonElement>('.net');
    const value = root.querySelector<HTMLElement>('.setup-v');
    const buttons = root.querySelectorAll<HTMLButtonElement>('.agents button');
    let pinned = false;
    const net = (off: boolean) => { root.dataset.net = off ? 'off' : 'on'; };
    toggle?.addEventListener('click', () => { pinned = !pinned; toggle.setAttribute('aria-pressed', String(pinned)); net(pinned); }, { signal });
    root.querySelectorAll<HTMLElement>('[data-offline]').forEach(row => {
      row.addEventListener('pointerenter', () => net(true), { signal });
      row.addEventListener('pointerleave', () => net(pinned || row === document.activeElement), { signal });
      row.addEventListener('focus', () => net(true), { signal });
      row.addEventListener('blur', () => net(pinned), { signal });
    });
    const pick = (b: HTMLButtonElement) => {
      if (!value || b.classList.contains('on')) return;
      buttons.forEach(x => x.classList.toggle('on', x === b));
      value.textContent = b.dataset.setup ?? '';
      value.classList.remove('swap');
      void value.offsetWidth;
      value.classList.add('swap');
    };
    buttons.forEach(b => {
      b.addEventListener('pointerenter', () => pick(b), { signal });
      b.addEventListener('focus', () => pick(b), { signal });
      b.addEventListener('click', () => pick(b), { signal });
    });
  });
  document.addEventListener('astro:before-swap', () => { yoursAbort?.abort(); yoursAbort = null; });
</script>
