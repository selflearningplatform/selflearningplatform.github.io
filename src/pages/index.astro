---
import Base from '../layouts/Base.astro';
import Cover from '../components/home/Cover.astro';
import Why from '../components/home/Why.astro';
import Pieces from '../components/home/Pieces.astro';
import Study from '../components/home/Study.astro';
import Method from '../components/home/Method.astro';
import Session from '../components/home/Session.astro';
import Memory from '../components/home/Memory.astro';
import Yours from '../components/home/Yours.astro';
import Start from '../components/home/Start.astro';
import Faq from '../components/home/Faq.astro';
import Closing from '../components/home/Closing.astro';
---
<Base description="A teacher that runs in your agent, a method it follows, and a local app where you do the work.">
  <link slot="head" rel="preload" href="/app/assets/lockup-horizontal.png" as="image" fetchpriority="high">
  <div data-page="home">
    <Cover />
    <Why />
    <Pieces />
    <Study />
    <Method />
    <Session />
    <Memory />
    <Yours />
    <Start />
    <Faq />
    <Closing />
  </div>

</Base>
