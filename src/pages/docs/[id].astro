---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { NAV, DOCS } from '../../nav.js';
import { render, title as titleOf } from '../../markdown.js';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { id, body, data } = entry;
const title = titleOf(body);
const blurb = body.match(/^# .+\n\n(.+)$/m)[1].replace(/[`*[\]]|\(.*?\)/g, '');
const next = DOCS[DOCS.findIndex(d => d.id === id) + 1];
const skill = id.startsWith('slp-') && `https://raw.githubusercontent.com/GustavoPenaBeltrami/self-learning-platform/main/agent/skills/${id}/SKILL.md`;
const site = Astro.site.origin;
---
<Base title={title} description={blurb}>
  <div data-page="docs" class="docs">
    <aside class="side">
      <input class="filter" type="search" placeholder="filter" aria-label="filter docs">
      <nav class="side-nav">
        {NAV.map(([section, items]) => (
          <details open><summary>{section}</summary>
            {items.map(([doc, label, tag]) => (
              <a href={`/docs/${doc}`} aria-current={doc === id ? 'page' : undefined}>{tag && <i class="tag">{tag}</i>}{label}</a>
            ))}
          </details>
        ))}
      </nav>
    </aside>

    <div class="doc-area">
      <article>
        <div class="doc-head"><h1>{title}</h1><div><button class="copy-page" data-src={`/docs/${id}.md`}>copy page</button><a href={`/docs/${id}.md`}>.md</a>{skill && <a class="skill-md" href={skill} download="SKILL.md">SKILL.md ↓</a>}</div></div>
        <div class="endpoint"><i class="tag">{data.tag}</i><code>{data.endpoint}</code>{data.copy && <button class="copy" aria-label="copy">⧉</button>}</div>
        <div class="doc-main" set:html={render(body)} />
      </article>
      {next && <a class="next" href={`/docs/${next.id}`}>{next.label} →</a>}
      <div class="toast" role="status" hidden>独学 · copied <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg></div>
      <section class="formats">
        <h2>Markdown formats</h2>
        <p>The documentation is also available in <a href="https://llmstxt.org/">llms.txt</a> formats:</p>
        <ul>
          <li><a href="/llms.txt">llms.txt</a> lists every documentation page.</li>
          <li><a href="/llms-full.txt">llms-full.txt</a> contains the complete documentation in one file and may exceed some context windows.</li>
        </ul>
        <p>Append <code>.md</code> to any documentation URL to retrieve that page as Markdown. For example, this page is available at <a href={`/docs/${id}.md`}><code>{site}/docs/{id}.md</code></a>. You can also copy the current page as Markdown by pressing <kbd>Cmd+C</kbd> or <kbd>Ctrl+C</kbd>.</p>
      </section>
    </div>
  </div>
</Base>

<script>
  const links = [...document.querySelectorAll('.side-nav a')];
  document.querySelector('.filter').addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    links.forEach(a => a.hidden = !a.textContent.toLowerCase().includes(q));
    document.querySelectorAll('.side details').forEach(d => {
      d.hidden = !d.querySelector('a:not([hidden])');
      if (q) d.open = true;
    });
  });

  const flash = (b, text) => {
    const was = b.textContent;
    b.textContent = text;
    setTimeout(() => b.textContent = was, 1200);
  };
  const copyPage = async page => {
    await navigator.clipboard.writeText(await fetch(page.dataset.src).then(r => r.text()));
    const toast = document.querySelector('.toast');
    toast.hidden = false;
    clearTimeout(toast.timer);
    toast.timer = setTimeout(() => toast.hidden = true, 1600);
  };
  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'c' && !getSelection().toString() && !e.target.closest('input, textarea')) copyPage(document.querySelector('.copy-page'));
  });
  document.addEventListener('click', async e => {
    const page = e.target.closest('.copy-page');
    if (page) return copyPage(page);
    const md = e.target.closest('.skill-md');
    if (md) {
      e.preventDefault();
      const url = URL.createObjectURL(await fetch(md.href).then(r => r.blob()));
      Object.assign(document.createElement('a'), { href: url, download: 'SKILL.md' }).click();
      return URL.revokeObjectURL(url);
    }
    const b = e.target.closest('.copy');
    if (!b) return;
    await navigator.clipboard.writeText(b.previousElementSibling.textContent);
    flash(b, '✓');
  });
</script>
