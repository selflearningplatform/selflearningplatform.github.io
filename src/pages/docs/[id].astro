---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { NAV, DOCS } from '../../nav.js';
import { render, title as titleOf } from '../../markdown.js';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { id, body, data } = entry;
const title = titleOf(body);
const blurb = body.match(/^# .+\n\n(.+)$/m)[1].replace(/[`*[\]]|\(.*?\)/g, '');
const next = DOCS[DOCS.findIndex(d => d.id === id) + 1];
---
<Base title={title} description={blurb}>
  <div data-page="docs" class="docs">
    <aside class="side">
      <input class="filter" type="search" placeholder="filter" aria-label="filter docs">
      <nav class="side-nav">
        {NAV.map(([section, items]) => (
          <details open><summary>{section}</summary>
            {items.map(([doc, label, tag]) => (
              <a href={`/docs/${doc}`} aria-current={doc === id ? 'page' : undefined}>{tag && <i class="tag">{tag}</i>}{label}</a>
            ))}
          </details>
        ))}
      </nav>
    </aside>

    <div class="doc-area">
      <article>
        <div class="doc-head"><h1>{title}</h1><div><button class="copy-page" data-src={`/docs/${id}.md`}>copy page</button><a href={`/docs/${id}.md`}>.md</a></div></div>
        <div class="endpoint"><i class="tag">{data.tag}</i><code>{data.endpoint}</code>{data.copy && <button class="copy" aria-label="copy">⧉</button>}</div>
        <div class="doc-main" set:html={render(body)} />
      </article>
      {next && <a class="next" href={`/docs/${next.id}`}>{next.label} →</a>}
    </div>
  </div>
</Base>

<script>
  const links = [...document.querySelectorAll('.side-nav a')];
  document.querySelector('.filter').addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    links.forEach(a => a.hidden = !a.textContent.toLowerCase().includes(q));
    document.querySelectorAll('.side details').forEach(d => {
      d.hidden = !d.querySelector('a:not([hidden])');
      if (q) d.open = true;
    });
  });

  const flash = (b, text) => {
    const was = b.textContent;
    b.textContent = text;
    setTimeout(() => b.textContent = was, 1200);
  };
  document.addEventListener('click', async e => {
    const page = e.target.closest('.copy-page');
    if (page) {
      await navigator.clipboard.writeText(await fetch(page.dataset.src).then(r => r.text()));
      return flash(page, 'copied ✓');
    }
    const b = e.target.closest('.copy');
    if (!b) return;
    await navigator.clipboard.writeText(b.previousElementSibling.textContent);
    flash(b, '✓');
  });
</script>
